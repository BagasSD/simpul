{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial (Ulasan Siswa)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "required": true,
      "inversedBy": "testimonials"
    },
    "full_name": {
      "type": "string",
      "required": true
    },
    "school_name": {
      "type": "string",
      "required": true
    },
    "major": {
      "type": "string",
      "required": true
    },
    "review": {
      "type": "text",
      "required": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  }
}
