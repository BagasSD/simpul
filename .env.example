# --- Server ---
HOST=0.0.0.0
PORT=1337
# URL publik backend saat deploy (contoh: https://simpul-api.up.railway.app)
PUBLIC_URL=
# Di production Railway, set PROXY_KOA=true
PROXY_KOA=false
PROXY_MAX_IPS_COUNT=1
# Origin yang boleh mengakses API (frontend). Pisahkan dengan koma. Contoh: http://localhost:3000,https://simpul.sch.id
CORS_ORIGINS=*

# --- Secrets (ganti semua! generate: openssl rand -base64 16) ---
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
ENCRYPTION_KEY=changeme
JWT_SECRET=changeme

# --- PostgreSQL ---
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=simpul
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SCHEMA=public
DATABASE_SSL=false
# DATABASE_URL dipakai Railway; kosongkan untuk koneksi lokal di atas.
DATABASE_URL=

# --- Upload media ---
# local untuk development; set cloudinary di Railway.
UPLOAD_PROVIDER=local
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER_NAME=simpul
